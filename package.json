{
  "name": "siweidaotu",
  "private": true,
  "version": "1.7.11",
  "description": "本地优先的个人知识思维导图与论文阅读工具",
  "author": "fly-01-hub",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages --outDir dist-pages",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:published": "playwright test --config playwright.published.config.ts",
    "publish:public": "node scripts/publish-public.mjs",
    "release:public": "npm run typecheck && npm test && npm run lint && npm run desktop:build -- --publish never && npm run verify:public && playwright test --config playwright.public.config.ts && npm run desktop:test && npm run build:pages && npm run test:pages && npm run publish:public && npm run test:published",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:public": "npm run build && playwright test --config playwright.public.config.ts",
    "verify:public": "node scripts/verify-public-package.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "lan:serve": "node scripts/lan-server.mjs",
    "lan:check": "node scripts/lan-server.mjs --check",
    "lan:cert-request": "node scripts/lan-certificate-request.mjs",
    "test:lan": "node --test tests/lan/server.test.mjs",
    "test:lan:browser": "playwright test --config playwright.lan.config.ts",
    "desktop:runtime": "node node_modules/electron/install.js",
    "desktop:start": "npm run desktop:runtime && npm run build && electron electron/main.cjs",
    "desktop:test": "playwright test --config playwright.desktop.config.ts",
    "desktop:build": "npm run desktop:runtime && npm run build && electron-builder --win nsis --x64",
    "desktop:unpacked": "npm run desktop:runtime && npm run build && electron-builder --win dir --x64",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs",
    "android:test": "npm run build && playwright test --config playwright.android.config.ts",
    "android:build": "npm run android:prepare && node scripts/build-android.mjs"
  },
  "dependencies": {
    "@mind-elixir/export-mindmap": "^0.1.10",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "dexie": "^4.4.6",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "mind-elixir": "^6.0.0-next.4",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.fly01hub.researchmind",
    "productName": "ResearchMind 枝间",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ResearchMind-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ResearchMind 枝间",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
